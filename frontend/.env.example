# Profexia frontend environment variables (Vite).
# Copy to `.env` for local development:  cp .env.example .env
# Only variables prefixed with VITE_ are exposed to the browser bundle --
# never put secrets here.

# Backend base URL. Either the origin or the full API prefix works:
#   http://localhost:8000            -> http://localhost:8000/api/v1
#   https://profexia-api.onrender.com/api/v1
# Development default when unset: http://localhost:8000
# Production (Vercel): set this in Project Settings -> Environment Variables.
VITE_API_URL=http://localhost:8000

# Optional WebSocket base override. When unset it is derived from VITE_API_URL
# (https -> wss, http -> ws).
# VITE_WS_URL=wss://profexia-api.onrender.com

# Reserved for a future cookie-based session strategy; currently unused.
VITE_SECURE_COOKIES=false
