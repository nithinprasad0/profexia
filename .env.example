# =============================================================================
# Profexia backend environment variables
# -----------------------------------------------------------------------------
# Local: copy to `.env` (git-ignored). docker-compose.yml already provides
#        working local values for the database, Redis and CORS.
# Production (Render): set these in the service's Environment tab.
# Placeholders only -- never commit real values.
# =============================================================================

# development | production   (production enables strict startup validation)
ENVIRONMENT=development

# --- PostgreSQL ---------------------------------------------------------------
# Any of these forms work; they are normalised to postgresql+asyncpg:// with ssl:
#   postgresql+asyncpg://profexia:profexia@postgres:5432/profexia        (docker-compose)
#   postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require  (Neon)
DATABASE_URL=postgresql+asyncpg://profexia:profexia@postgres:5432/profexia

# --- Redis --------------------------------------------------------------------
# Local: redis://redis:6379/0
# Upstash (TLS required -> note the double "s"):
#   rediss://default:PASSWORD@YOUR-DB.upstash.io:6379
REDIS_URL=redis://redis:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=5

# --- Authentication -----------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---------------------------------------------------------------------
# Comma-separated exact origins (scheme + host, no trailing slash, no paths).
# Development automatically allows http://localhost:5173 and http://127.0.0.1:5173.
CORS_ORIGINS=https://your-frontend.vercel.app
# Optional regex for Vercel preview deployments, e.g.
# ^https://profexia-[a-z0-9-]+-your-team\.vercel\.app$
CORS_ORIGIN_REGEX=

# --- Rate limiting (Redis fixed windows; set any limit to 0 to disable it) ------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_FAILURES_PER_ACCOUNT=5
RATE_LIMIT_LOGIN_FAILURE_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_PER_IP=30
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_PER_IP=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_REFRESH_PER_IP=60
RATE_LIMIT_REFRESH_WINDOW_SECONDS=900
RATE_LIMIT_CODE_EXECUTIONS_PER_USER=30
RATE_LIMIT_CODE_EXECUTION_WINDOW_SECONDS=3600
# Reverse proxies in front of the API that append to X-Forwarded-For.
# 0 = use the TCP peer address (local/docker). Render: 1 (see docs/DEPLOYMENT.md).
TRUSTED_PROXY_COUNT=0

# --- Real-time fan-out ----------------------------------------------------------
# redis  = WebSocket events are shared between API instances through Redis pub/sub.
# memory = single instance only (no Redis traffic for real-time).
REALTIME_BACKEND=redis
REALTIME_CHANNEL=profexia:realtime

# --- Startup ------------------------------------------------------------------
# true: the container runs `alembic upgrade head` + role seeding before serving.
RUN_MIGRATIONS_ON_STARTUP=true

# --- Razorpay (https://dashboard.razorpay.com/app/keys) --------------------------
# Test keys start with rzp_test_, live keys with rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# --- Judge0 -------------------------------------------------------------------
# RapidAPI: JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com, JUDGE0_AUTH_HEADER=X-RapidAPI-Key
# Self-hosted: your Judge0 URL, JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_BASE_URL=
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=X-RapidAPI-Key
JUDGE0_WAIT=true
JUDGE0_TIMEOUT_SECONDS=20
JUDGE0_CPU_TIME_LIMIT=5
JUDGE0_WALL_TIME_LIMIT=10
JUDGE0_MEMORY_LIMIT_KB=128000

# --- LiveKit (https://cloud.livekit.io -> Settings -> Keys) ----------------------
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud
